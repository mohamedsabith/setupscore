# npm settings for working on setupscore. They are not published (package.json "files" decides what is).
# Refuse to install when this Node.js version is outside an "engines" range.
engine-strict=true
# Supply-chain protection: only install versions that have been public for at least 7 days.
# Most malicious package versions are found and removed within hours or days. Needs npm 11.10+;
# older npm versions warn about an unknown setting and carry on.
min-release-age=7
# Never install dependencies straight from git repositories: they skip the registry's checks.
allow-git=none
