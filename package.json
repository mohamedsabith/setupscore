{
  "name": "setupscore",
  "version": "1.0.4",
  "description": "Check your Claude Code setup (CLAUDE.md, rules, skills, agents, settings, .mcp.json) for broken paths, leaked secrets and contradictions, then measure whether it actually helps: real tasks from your git history, run in an OS sandbox, with a Setup Score.",
  "keywords": [
    "claude",
    "claude-code",
    "claude-md",
    "ai-agents",
    "coding-agent",
    "lint",
    "linter",
    "skills",
    "mcp",
    "cli"
  ],
  "homepage": "https://github.com/mohamedsabith/setupscore#readme",
  "bugs": {
    "url": "https://github.com/mohamedsabith/setupscore/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedsabith/setupscore.git"
  },
  "license": "MIT",
  "author": "Mohamed Sabith (https://github.com/mohamedsabith)",
  "type": "module",
  "bin": {
    "setupscore": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs/rules.md",
    "docs/sandbox.md",
    "docs/run.md",
    "docs/reference.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "check:self": "node dist/cli.js check examples/bakery-api",
    "corpus": "npm run build && node scripts/corpus-diff.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:fast": "vitest run test/core.test.ts test/rules.test.ts test/agents-md.test.ts test/broken-hook.test.ts test/redos.test.ts",
    "coverage": "npm run build && vitest run --coverage",
    "check-all": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-regexp": "^3.3.3",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
